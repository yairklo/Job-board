PORT=8181
NODE_ENV=development

# Prefer MONGO_URI when set (local or Atlas). Otherwise NODE_ENV picks a URI below.
MONGO_URI=mongodb://127.0.0.1:27017/JobBoard
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/JobBoard
ATLAS_MONGO_URI=

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h

CLIENT_URL=http://localhost:5173
DEFAULT_JOB_IMAGE_URL=

ADMIN_EMAIL=admin@jobboard.local
ADMIN_PASSWORD=Admin1234!
